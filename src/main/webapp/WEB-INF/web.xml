<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>sample-fake-java</display-name>

    <listener>
        <listener-class>com.example.library.servlet.AppInitializer</listener-class>
    </listener>

    <servlet>
        <servlet-name>BookServlet</servlet-name>
        <servlet-class>com.example.library.servlet.BookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookServlet</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemberServlet</servlet-name>
        <servlet-class>com.example.library.servlet.MemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemberServlet</servlet-name>
        <url-pattern>/members</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoanServlet</servlet-name>
        <servlet-class>com.example.library.servlet.LoanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoanServlet</servlet-name>
        <url-pattern>/loans</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
